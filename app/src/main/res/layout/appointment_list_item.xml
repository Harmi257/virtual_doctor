<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#f5f5f5"
    android:layout_marginBottom="8dp"
    >

    <!-- Patient Info -->
    <TextView
        android:id="@+id/textPatientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Name"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textPatientEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Email"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textPatientPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Phone"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textPatientAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Address"
        android:textSize="14sp" />

    <!-- Appointment Info -->
    <TextView
        android:id="@+id/textSymptoms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Symptoms"
        android:textStyle="italic"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/textDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duration" />

    <TextView
        android:id="@+id/textSeverity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Severity" />

    <TextView
        android:id="@+id/textMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mode" />
    <TextView
        android:id="@+id/textStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: pending" />


    <Button
        android:id="@+id/btnAccept"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accept"
        android:layout_marginTop="8dp" />
    <Button
        android:id="@+id/btnReject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reject" />
    <Button
        android:id="@+id/btnScheduleMeeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Schedule Meeting"
        android:visibility="gone" />  <!-- start as gone -->


</LinearLayout>
